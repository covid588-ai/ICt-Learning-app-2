// Prisma Schema for EduLearn Educational Platform
// PostgreSQL Database with complete relational structure

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  ADMIN
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum ContentType {
  VIDEO
  PDF
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String?
  avatar        String?
  role          UserRole     @default(STUDENT)
  status        UserStatus   @default(ACTIVE)
  emailVerified DateTime?
  googleId      String?      @unique
  accessToken   String?      @db.Text
  refreshToken  String?      @db.Text
  tokenExpiry   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  progress      LearningProgress[]
  bookmarks     Bookmark[]
  sessions      Session[]

  @@index([email])
  @@index([googleId])
  @@index([role])
  @@index([status])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// EDUCATIONAL CONTENT HIERARCHY
// ============================================

model Subject {
  id          String         @id @default(cuid())
  title       String
  description String?        @db.Text
  icon        String?
  coverImage  String?
  order       Int            @default(0)
  published   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  chapters    Chapter[]

  @@index([published])
  @@index([order])
}

model Chapter {
  id          String         @id @default(cuid())
  subjectId   String
  title       String
  description String?        @db.Text
  order       Int            @default(0)
  published   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  subject     Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics      Topic[]

  @@index([subjectId])
  @@index([published])
  @@index([order])
  @@unique([subjectId, order])
}

model Topic {
  id          String         @id @default(cuid())
  chapterId   String
  title       String
  description String?        @db.Text
  order       Int            @default(0)
  published   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  chapter     Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  materials   LearningMaterial[]

  @@index([chapterId])
  @@index([published])
  @@index([order])
  @@unique([chapterId, order])
}

model LearningMaterial {
  id          String        @id @default(cuid())
  topicId     String
  type        ContentType
  title       String
  description String?       @db.Text
  driveFileId String        @unique
  order       Int           @default(0)
  published   Boolean       @default(false)
  thumbnail   String?
  duration    Int?          // in seconds for videos
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  topic       Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  progress    LearningProgress[]
  bookmarks   Bookmark[]

  @@index([topicId])
  @@index([type])
  @@index([published])
  @@index([order])
  @@index([driveFileId])
  @@unique([topicId, order])
}

// ============================================
// STUDENT PROGRESS & INTERACTIONS
// ============================================

model LearningProgress {
  id               String   @id @default(cuid())
  userId           String
  materialId       String
  playbackPosition Int      @default(0) // in seconds
  completed        Boolean  @default(false)
  completedAt      DateTime?
  lastWatched      DateTime @default(now())
  watchCount       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  material LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@index([userId])
  @@index([materialId])
  @@index([completed])
  @@index([lastWatched])
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  materialId String
  createdAt  DateTime @default(now())

  // Relations
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  material LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@index([userId])
  @@index([materialId])
}

// ============================================
// ADMIN SETTINGS & CONFIGURATION
// ============================================

model AppSettings {
  id                String   @id @default(cuid())
  key               String   @unique
  value             String   @db.Text
  description       String?
  updatedAt         DateTime @updatedAt

  @@index([key])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}