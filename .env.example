# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://username:password@localhost:5432/edulearn?schema=public"

# ============================================
# NEXTAUTH
# ============================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars-generate-with-openssl-rand-base64-32"

# ============================================
# GOOGLE OAUTH
# ============================================
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Google OAuth Scopes (space-separated)
# drive.readonly - Read all files (requires verification for sensitive scope)
# drive.file - Only files created/opened by app (uses Google Picker)
GOOGLE_DRIVE_SCOPE="https://www.googleapis.com/auth/drive.readonly"

# ============================================
# GOOGLE DRIVE API
# ============================================
GOOGLE_DRIVE_API_KEY="your-google-drive-api-key"
GOOGLE_PICKER_API_KEY="your-google-picker-api-key"
GOOGLE_PICKER_APP_ID="your-project-number"

# ============================================
# APP CONFIGURATION
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="EduLearn"
NEXT_PUBLIC_DEFAULT_LANGUAGE="bn"

# First Admin Setup (used only on first run)
INITIAL_ADMIN_EMAIL="admin@yourdomain.com"

# ============================================
# STORAGE (Optional - for future use)
# ============================================
# AWS_S3_BUCKET=""
# AWS_S3_REGION=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# ============================================
# EMAIL (Optional - for notifications)
# ============================================
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASSWORD=""
# EMAIL_FROM=""

# ============================================
# ANALYTICS (Optional)
# ============================================
# NEXT_PUBLIC_GA_ID=""